# Только локальная разработка с синтетическими данными. Compose читает этот файл после копирования в .env.
DB_USER=koren
DB_PASSWORD=koren_local_only
DB_NAME=koren
# Для прогона scripts/qa_e03.py подставить тестовый токен из MaxInitDataValidatorTest.
MAX_BOT_TOKEN=
# Bot name for the button into the Mini App. Not a secret.
MAX_BOT_NAME=t109_hakaton_max_bot
# Секрет webhook MAX. Пустой - маршрута /max/webhook не существует, бот выключен целиком.
MAX_WEBHOOK_SECRET=
# Фоновые воркеры входящих и исходящих событий бота.
MAX_WORKERS_ENABLED=false
# Анализ отчётов в Python. Выключен - отчёт сохраняется с MANUAL_REQUIRED, связи выбирает человек.
ANALYSIS_ENABLED=false
# Режим сравнения в Python: stub (по умолчанию, ничего не утверждает) или rules.
COMPARE_ANALYZER=stub
# RELEASE_SHA здесь не хранится: выпуск передаёт его командой RELEASE_SHA=$(git rev-parse HEAD) docker compose up -d --build
# Kafka и индекс похожих обращений. Выключены в кандидате; для включения: KAFKA_ENABLED=true и docker compose --profile similar up
KAFKA_ENABLED=false
# Профиль backend. demo открывает учебные /api/v1/demo/** для разработки; на стенде обязательно release.
SPRING_PROFILES_ACTIVE=demo
# Префикс номера обращения. Пусто - «124»; синтетический стенд может подписать номера, например ДЕМО-
CASE_NUMBER_PREFIX=
