{
  "openapi": "3.1.0",
  "info": {
    "title": "KOREN inference",
    "version": "0.2.0"
  },
  "paths": {
    "/internal/v1/compare": {
      "post": {
        "tags": [
          "inference"
        ],
        "summary": "Compare Report",
        "operationId": "compare_report_internal_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "LIGHTING",
          "ENTRANCE_DOOR",
          "CLEANING",
          "OTHER"
        ],
        "title": "Category"
      },
      "CompareRequest": {
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid",
            "title": "Caseid"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sourcerevision"
          },
          "reportId": {
            "type": "string",
            "format": "uuid",
            "title": "Reportid"
          },
          "reportText": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Reporttext"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "caseId",
          "sourceRevision",
          "reportId",
          "reportText",
          "items"
        ],
        "title": "CompareRequest"
      },
      "CompareResponse": {
        "properties": {
          "caseId": {
            "type": "string",
            "format": "uuid",
            "title": "Caseid"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sourcerevision"
          },
          "reportId": {
            "type": "string",
            "format": "uuid",
            "title": "Reportid"
          },
          "modelVersion": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Modelversion"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Suggestions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "caseId",
          "sourceRevision",
          "reportId",
          "modelVersion",
          "mode",
          "suggestions"
        ],
        "title": "CompareResponse"
      },
      "Evidence": {
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End"
          },
          "quote": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "quote"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid",
            "title": "Itemid"
          },
          "contentVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Contentversion"
          },
          "workRound": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Workround"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Location"
          },
          "symptom": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Symptom"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "itemId",
          "contentVersion",
          "workRound",
          "category",
          "location",
          "symptom"
        ],
        "title": "Item"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "STUB",
          "RULES",
          "NLI",
          "MANUAL"
        ],
        "title": "Mode"
      },
      "Reason": {
        "type": "string",
        "enum": [
          "MODEL_NOT_CONFIGURED",
          "ANALYSIS_UNAVAILABLE",
          "ANALYZED"
        ],
        "title": "Reason"
      },
      "Relation": {
        "type": "string",
        "enum": [
          "REPORTED_DONE",
          "PLANNED",
          "SYMPTOM_PERSISTS",
          "INSUFFICIENT_INFORMATION",
          "UNRELATED",
          "CONFLICT"
        ],
        "title": "Relation"
      },
      "Suggestion": {
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid",
            "title": "Itemid"
          },
          "contentVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Contentversion"
          },
          "workRound": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Workround"
          },
          "relation": {
            "$ref": "#/components/schemas/Relation"
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Evidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "itemId",
          "contentVersion",
          "workRound",
          "relation",
          "evidence",
          "reason"
        ],
        "title": "Suggestion"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
