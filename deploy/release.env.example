# Copy outside Git; chmod 600. Never use the user's SSH password for DB_PASSWORD.
DB_PASSWORD=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WORKERS_ENABLED=false
RELEASE_SHA=
SITE_ADDRESS=hackathon.lumnex.ru
WEB_PORT=8090
SESSION_COOKIE_SECURE=true
# MAX Web embeds the Mini App in a cross-site iframe; both cookies require HTTPS.
SESSION_COOKIE_SAMESITE=None
ANALYSIS_ENABLED=false
# Set RELEASE_SHA to the full Git SHA of the source being deployed.
# Enable MAX workers after checking the token, webhook secret and recipient on the stand.
# Enable analysis only together with --profile analysis.
